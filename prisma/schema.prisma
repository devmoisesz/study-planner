generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  passwordHash String

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum ResourceType {
  YOUTUBE
  BOOK
  PDF
  WEBSITE
  OTHER
}

model Task {
  id          String  @id @default(uuid())
  title       String
  description String?
  score       Int

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  resources      Resource[]
  productivities Productivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("tasks")
}

model Resource {
  id          String       @id @default(uuid())
  title       String
  type        ResourceType
  url         String?
  description String?

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("resources")
}

model Productivity {
  id         String @id @default(uuid())
  percentage Int

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("productivities")
}
